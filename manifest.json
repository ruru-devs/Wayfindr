{
  "manifest_version": 3,
  "name": "Wayfindr — Intent-Driven Web Navigation",
  "version": "1.0.0",
  "description": "Stop navigating websites. Tell them what you want. Instant cross-page intent navigation with Ctrl+K.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background/service_worker.js",
    "scripts": ["dist/background/service_worker.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wayfindr@ruru-devs.com",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content/content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-wayfindr": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "Alt+K"
      },
      "description": "Toggle Wayfindr intent navigation palette"
    }
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Wayfindr Navigation"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
